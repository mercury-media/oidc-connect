{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SapCdcOidc": {
    "Authority": "https://<your-site>.accounts.ondemand.com",
    "MetadataAddress": "https://<your-site>.accounts.ondemand.com/.well-known/openid-configuration",
    "EndSessionEndpoint": "https://<your-site>.accounts.ondemand.com/oidc/op/v1.0/end_session",
    "ClientId": "<client-id>",
    "ClientSecret": "<client-secret>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/loggedout",
    "TrustedPostLogoutUrl": "https://localhost:5001/loggedout"
  }
}
