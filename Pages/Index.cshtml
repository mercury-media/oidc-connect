@page
@model IndexModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SAP CDC OIDC Login/Logout Scenarios</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 2rem; line-height: 1.5; }
        .card { border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; }
        .btn { padding: 0.6rem 1rem; border: 1px solid #444; border-radius: 6px; background: #f7f7f7; cursor: pointer; margin-right: 0.5rem; }
        .muted { color: #666; }
        code { background: #f4f4f4; padding: 2px 5px; border-radius: 4px; }
    </style>
</head>
<body>
<h1>SAP CDC OIDC Login/Logout Playground</h1>

<div class="card">
    <h2>Session</h2>
    <p><strong>Authenticated:</strong> @Model.IsAuthenticated</p>
    @if (Model.IsAuthenticated)
    {
        <p><strong>Name:</strong> @Model.DisplayName</p>
    }
</div>

<div class="card">
    <h2>1) Login</h2>
    <p>Trigger an OpenID Connect challenge from the relying party (RP) to the SAP CDC OP.</p>
    <a class="btn" href="/login">Login with OIDC</a>
</div>

<div class="card">
    <h2>2) Standard User Logout Flow (SAP CDC)</h2>
    <p>This page reproduces the flow you described:</p>
    <ol>
        <li>User clicks logout in RP.</li>
        <li>RP calls <code>end_session_endpoint</code> with <code>id_token</code>, <code>client_id</code>, and <code>postLogoutUrl</code>.</li>
        <li>OP redirects with <code>mode=consentLogout</code> and presents logout options.</li>
        <li>User is redirected to the trusted post logout URL.</li>
    </ol>
    <form method="post" action="/logout/standard">
        <button class="btn" type="submit">Start Standard Logout</button>
    </form>
</div>

<div class="card">
    <h2>3) RP-only Logout</h2>
    <p>Clears only the local RP cookie/session (no OP logout call).</p>
    <form method="post" action="/logout/rp">
        <button class="btn" type="submit">Logout RP Only</button>
    </form>
</div>

<p class="muted">Tip: set real SAP CDC values in <code>appsettings.json</code> before running.</p>
</body>
</html>
